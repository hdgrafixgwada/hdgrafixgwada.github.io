  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #07111f;
      color: white;
      line-height: 1.6;
    }

    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(7, 17, 31, 0.95);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    nav {
      max-width: 1150px;
      margin: auto;
      padding: 18px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 23px;
      font-weight: 900;
      color: #00d9ff;
    }

    .logo span {
      color: white;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 25px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    nav a:hover {
      color: #00d9ff;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 120px 20px 70px;
      background:
        radial-gradient(circle at top right, #064e68 0%, transparent 35%),
        radial-gradient(circle at bottom left, #142b55 0%, transparent 35%),
        #07111f;
    }

    .hero-content {
      max-width: 850px;
    }

    .hero h1 {
      font-size: clamp(45px, 8vw, 85px);
      line-height: 1;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #00d9ff;
    }

    .hero p {
      font-size: 20px;
      color: #c8d5e5;
      max-width: 700px;
      margin: auto;
    }

    .tagline {
      margin-top: 12px;
      color: #00d9ff !important;
      font-weight: bold;
    }

    .buttons {
      margin-top: 35px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 14px 27px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .primary {
      background: #00d9ff;
      color: #06101c;
    }

    .secondary {
      border: 2px solid #00d9ff;
      color: white;
    }

    .btn:hover {
      transform: translateY(-4px);
    }

    section {
      padding: 90px 20px;
    }

    .container {
      max-width: 1100px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 40px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #aebdce;
    }

    .about {
      background: #0a1728;
    }

    .about-box {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .about-box p {
      color: #c7d3e0;
      font-size: 18px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .service {
      background: #0c1d31;
      border: 1px solid rgba(0,217,255,0.15);
      border-radius: 18px;
      padding: 30px 20px;
      text-align: center;
      transition: 0.3s;
    }

    .service:hover {
      transform: translateY(-8px);
      border-color: #00d9ff;
    }

    .service .icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .service h3 {
      margin-bottom: 10px;
    }

    .service p {
      color: #aebdce;
    }

    .portfolio {
      background: #07111f;
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .portfolio-card {
      min-height: 220px;
      border-radius: 18px;
      padding: 30px;
      display: flex;
      align-items: end;
      background: linear-gradient(135deg, #123b5d, #081322);
      border: 1px solid rgba(255,255,255,0.1);
      overflow: hidden;
    }

    .portfolio-card h3 {
      font-size: 22px;
    }

    .contact {
      background: #0a1728;
    }

    .contact-box {
      text-align: center;
      max-width: 700px;
      margin: auto;
    }

    .contact-box p {
      color: #c3d0df;
      margin-bottom: 25px;
      font-size: 18px;
    }

    .whatsapp {
      background: #25D366;
      color: white;
    }

    footer {
      text-align: center;
      padding: 30px 20px;
      background: #050c16;
      color: #93a4b7;
    }

    footer strong {
      color: #00d9ff;
    }

    @media (max-width: 800px) {
      nav ul {
        display: none;
      }

      .services,
      .portfolio-grid {
        grid-template-columns: 1fr;
      }

      .hero p {
        font-size: 17px;
      }

      section {
        padding: 70px 20px;
      }
    }
  </style>
</head>

